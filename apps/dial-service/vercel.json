{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/clarifications",
      "destination": "/api/clarifications"
    },
    {
      "source": "/clarifications/:id",
      "destination": "/api/clarifications/:id"
    },
    {
      "source": "/knowledge",
      "destination": "/api/knowledge"
    },
    {
      "source": "/stakeholders",
      "destination": "/api/stakeholders"
    },
    {
      "source": "/dial/webhook",
      "destination": "/api/dial/webhook"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
