# Dial (https://docs.getdial.ai)
DIAL_API_KEY=sk_live_...
DIAL_FROM_NUMBER=            # optional: Dial number id, E.164, or nickname; default = first number that can call
DIAL_WEBHOOK_SECRET=whsec_...  # from POST /api/v1/webhooks

# Shared secret the Claude Code plugin sends as a Bearer token
SUPERPOWER_TOKEN=

# Who Superpower may call, per engagement. Phone numbers stay server-side.
STAKEHOLDERS_JSON={"acme":[{"id":"finance-manager","name":"Priya Shah","role":"Finance Manager","phone":"+15555550100","expertise":["approvals","discounts","billing","reconciliation","finance"]}]}

# Optional
ANTHROPIC_API_KEY=           # enables structured answer extraction
KNOWLEDGE_INGEST_URL=        # team knowledge backend endpoint that receives answered clarifications
KNOWLEDGE_INGEST_TOKEN=
