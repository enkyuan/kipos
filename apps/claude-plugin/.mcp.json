{
  "mcpServers": {
    "superpower": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.mjs"],
      "env": {
        "SUPERPOWER_API_URL": "${user_config.api_url}",
        "SUPERPOWER_KNOWLEDGE_URL": "${user_config.knowledge_url}",
        "SUPERPOWER_TOKEN": "${user_config.api_token}",
        "SUPERPOWER_ENGAGEMENT_ID": "${user_config.engagement_id}",
        "SUPERPOWER_REQUESTER": "${user_config.engineer_name}"
      }
    }
  }
}
