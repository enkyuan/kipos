# Copy to apps/api/.env (Bun loads it automatically). Never commit .env.
PORT=3001
DATABASE_PATH=./data/kipos.sqlite

# Vexa (meeting bot + transcription). Hosted: sign in at https://vexa.ai/signin
# with a Google account and copy the key from https://vexa.ai/account (free
# credit, no card). Self-hosted: set VEXA_API_URL to your gateway, e.g.
# http://localhost:18056.
VEXA_API_KEY=
VEXA_API_URL=https://api.cloud.vexa.ai

# Optional: signed lifecycle webhooks (a durable second path for bot status).
# Needs a public HTTPS URL for this API, e.g. `cloudflared tunnel --url
# http://localhost:3001`, then:
#   curl -X PUT "$VEXA_API_URL/user/webhook" -H "X-API-Key: $VEXA_API_KEY" \
#     -H "Content-Type: application/json" -d '{"webhook_url":"<public>/api/webhooks/vexa",
#     "webhook_secret":"<same as below>","webhook_events":{"meeting.status_change":true,
#     "meeting.completed":true,"bot.failed":true}}'
VEXA_WEBHOOK_SECRET=

# Optional: live requirement extraction, Claude on Amazon Bedrock. Without
# credentials the transcript works and the analysis panel says analysis is off.
# Either a Bedrock API key (bearer token)...
AWS_BEARER_TOKEN_BEDROCK=
# ...or an IAM access key pair allowed bedrock:InvokeModel on the inference
# profile below (AWS_SESSION_TOKEN too when the pair is temporary). The API
# key wins when both are set; half a pair fails startup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# A cross-region inference profile (on-demand model IDs are refused).
ANALYSIS_MODEL=us.anthropic.claude-sonnet-4-6
