# Local environment files. Never commit real secrets.
.env
.env.*
!.env.example

# Bun workspace dependencies and build output.
node_modules/
dist/
.output/
.tanstack/
*.tsbuildinfo

# Local durable state (apps/api SQLite files).
apps/api/data/

.DS_Store

# Claude Code harness state (machine-local).
.claude/*.lock

# Zodiak (Fontshare FFL) may be self-hosted but not redistributed, and this
# repository is public: keep the font and its license out of git.
# Any case, any file from Fontshare's archive (italics, TTFs, FFL.txt).
packages/ui/src/fonts/*[Zz][Oo][Dd][Ii][Aa][Kk]*
packages/ui/src/fonts/*[Ff][Ff][Ll]*
