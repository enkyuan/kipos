{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tooling/**/*.ts"],
      "project": ["tooling/**/*.ts"],
    },
    "apps/api": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/web": {
      // Knip's TanStack and Vite plugins find the router and config;
      // routeTree.gen.ts is generated and imports every route.
      "entry": ["src/routes/**/*.tsx", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts"],
    },
    "packages/ui": {
      // Every subpath export is public API consumed as source by the apps,
      // so each exported module is an entry point.
      "entry": ["src/**/*.{ts,tsx}", "scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/*.ts", "test/**/*.ts"],
    },
    "packages/tsconfig": {
      // Consumed through tsconfig `extends`, which is not an import graph.
      "entry": ["base.json"],
    },
  },
}
