      "default": "./src/primitives/button.tsx"
    },
    "./card": {
      "types": "./src/primitives/card.tsx",
      "default": "./src/primitives/card.tsx"
    },
    "./checkbox": {
      "types": "./src/primitives/checkbox.tsx",
      "default": "./src/primitives/checkbox.tsx"
    },
    "./dialog": {
      "types": "./src/primitives/dialog.tsx",
      "default": "./src/primitives/dialog.tsx"
    },
    "./field": {
      "types": "./src/primitives/field.tsx",
      "default": "./src/primitives/field.tsx"
